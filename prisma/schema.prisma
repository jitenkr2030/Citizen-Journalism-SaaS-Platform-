// Citizen Journalism SaaS Platform Schema
// Multi-tenant platform for independent journalists

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Journalists/Channel Owners
model Journalist {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  profileImage  String?
  channelName   String   @unique
  channelSlug   String   @unique
  bio           String?
  location      String?
  plan          SubscriptionPlan @default(BASIC)
  planStatus    SubscriptionStatus @default(ACTIVE)
  stripeCustomerId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  articles      Article[]
  videos        Video[]
  complaints    Complaint[]
  liveStreams   LiveStream[]
  donations     Donation[]
  advertisements Advertisement[]
  citizenReporters CitizenReporter[]
  memberships   Membership[]

  @@map("journalists")
}

// News Articles
model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  status      ArticleStatus @default(DRAFT)
  tags        String?
  journalistId String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalist  Journalist @relation(fields: [journalistId], references: [id], onDelete: Cascade)
  views       Int @default(0)

  @@map("articles")
}

// Video Content
model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  thumbnailUrl String?
  duration    Int?
  status      VideoStatus @default(UPLOADING)
  tags        String?
  journalistId String
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalist  Journalist @relation(fields: [journalistId], references: [id], onDelete: Cascade)
  views       Int @default(0)

  @@map("videos")
}

// Public Complaints/Leads
model Complaint {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  title       String
  description String
  category    ComplaintCategory
  location    String?
  evidence    String? // URL to uploaded files
  status      ComplaintStatus @default(PENDING)
  journalistId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalist  Journalist? @relation(fields: [journalistId], references: [id], onDelete: SetNull)

  @@map("complaints")
}

// Live Streaming Sessions
model LiveStream {
  id          String   @id @default(cuid())
  title       String
  description String?
  streamKey   String   @unique
  streamUrl   String?
  status      StreamStatus @default(SCHEDULED)
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  journalistId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalist  Journalist @relation(fields: [journalistId], references: [id], onDelete: Cascade)

  @@map("live_streams")
}

// Citizen Reporters Network
model CitizenReporter {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  location    String?
  idProof     String? // URL to ID verification
  status      ReporterStatus @default(PENDING)
  journalistId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalist  Journalist @relation(fields: [journalistId], references: [id], onDelete: Cascade)
  reports     Report[]

  @@map("citizen_reporters")
}

// Reports from Citizen Reporters
model Report {
  id          String   @id @default(cuid())
  title       String
  content     String
  media       String? // URL to uploaded media
  location    String?
  status      ReportStatus @default(PENDING)
  reporterId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  reporter    CitizenReporter @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// Donations & Memberships
model Donation {
  id          String   @id @default(cuid())
  name        String
  email       String
  amount      Float
  message     String?
  type        DonationType @default(DONATION)
  status      DonationStatus @default(PENDING)
  journalistId String
  stripePaymentIntentId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalist  Journalist @relation(fields: [journalistId], references: [id], onDelete: Cascade)

  @@map("donations")
}

// Monthly Memberships
model Membership {
  id          String   @id @default(cuid())
  name        String
  email       String
  amount      Float
  type        MembershipType
  status      MembershipStatus @default(ACTIVE)
  journalistId String
  stripeSubscriptionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalist  Journalist @relation(fields: [journalistId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

// Advertisement System
model Advertisement {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  targetUrl   String?
  location    String?
  budget      Float
  status      AdStatus @default(ACTIVE)
  journalistId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  journalist  Journalist @relation(fields: [journalistId], references: [id], onDelete: Cascade)
  impressions Int @default(0)
  clicks      Int @default(0)

  @@map("advertisements")
}

// Enums
enum SubscriptionPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  SUSPENDED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  PUBLISHED
  FAILED
}

enum ComplaintStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum ComplaintCategory {
  CORRUPTION
  INFRASTRUCTURE
  HEALTHCARE
  EDUCATION
  POLICE
  OTHER
}

enum StreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ReporterStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum DonationType {
  DONATION
  TIP
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum MembershipType {
  SUPPORTER
  PREMIUM
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum AdStatus {
  ACTIVE
  PAUSED
  EXPIRED
}